  "components": {
    "schemas": {
      "BatchRequest": {
        "properties": {
          "requests": {
            "items": {
              "$ref": "#/components/schemas/JobRequest"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Requests"
          }
        },
        "type": "object",
        "required": [
          "requests"
        ],
        "title": "BatchRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRequest": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "flow",
              "muse"
            ],
            "title": "Provider"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video",
              "scene",
              "text"
            ],
            "title": "Kind"
          },
          "prompt": {
            "type": "string",
            "maxLength": 120000,
            "minLength": 1,
            "title": "Prompt"
          },
          "aspect_ratio": {
            "type": "string",
            "enum": [
              "9:16",
              "16:9"
            ],
            "title": "Aspect Ratio",
            "default": "9:16"
          },
          "duration_seconds": {
            "type": "integer",
            "const": 8,
            "title": "Duration Seconds",
            "default": 8
          },
          "image_model": {
            "type": "string",
            "enum": [
              "NANO_BANANA_PRO",
              "NANO_BANANA_2",
              "NANO_BANANA_2_LITE"
            ],
            "title": "Image Model",
            "default": "NANO_BANANA_PRO"
          },
          "account_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Id"
          },
          "project_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Project Id"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "kind",
          "prompt"
        ],
        "title": "JobRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}